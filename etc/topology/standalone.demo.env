# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# This demo environment MUST use a dedicated PostgreSQL schema/user `sdkwork_xiangqi_demo` and a
# dedicated Redis prefix `xiangqi-demo` on a distinct logical DB index so no cache key (session,
# rate-limit, match/idempotency) collides with another environment sharing the deployment Redis.
SDKWORK_XIANGQI_DEPLOYMENT_PROFILE=standalone
SDKWORK_XIANGQI_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_XIANGQI_PROFILE_ID=standalone.demo
SDKWORK_XIANGQI_APPLICATION_PUBLIC_HTTP_URL=https://xiangqi-demo.sdkwork.com

