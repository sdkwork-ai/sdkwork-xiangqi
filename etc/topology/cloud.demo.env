# cloud.demo — cloud independent demonstration deployment, fully isolated from dev/test/staging/prod.
# This demo environment MUST use a dedicated PostgreSQL schema/user `sdkwork_xiangqi_demo` and a
# dedicated Redis prefix `xiangqi-demo` on a distinct logical DB index so no cache key collides with
# another environment sharing the deployment Redis.
SDKWORK_XIANGQI_DEPLOYMENT_PROFILE=cloud
SDKWORK_XIANGQI_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_XIANGQI_PROFILE_ID=cloud.demo
SDKWORK_XIANGQI_APPLICATION_PUBLIC_HTTP_URL=https://xiangqi-demo.sdkwork.com
SDKWORK_XIANGQI_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_XIANGQI_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_CORS_ALLOWED_ORIGINS=https://xiangqi-demo.sdkwork.com,http://xiangqi-demo.sdkwork.com,https://xiangqi-demo.birdcoder.com,http://xiangqi-demo.birdcoder.com,https://xiangqi-demo.dtupay.com,http://xiangqi-demo.dtupay.com,https://xiangqi-demo.noaper.com,http://xiangqi-demo.noaper.com,https://xiangqi-demo.sdkwork.cn,http://xiangqi-demo.sdkwork.cn,https://xiangqi-demo.birdcoder.cn,http://xiangqi-demo.birdcoder.cn,https://xiangqi-demo.dtupay.cn,http://xiangqi-demo.dtupay.cn,https://xiangqi-demo.noaper.cn,http://xiangqi-demo.noaper.cn,https://xiangqi-demo.skubc.com,http://xiangqi-demo.skubc.com,https://xiangqi-demo.skubc.cn,http://xiangqi-demo.skubc.cn,https://xiangqi-demo.zowalk.com,http://xiangqi-demo.zowalk.com,https://xiangqi-demo.zowalk.cn,http://xiangqi-demo.zowalk.cn,https://xiangqi-demo.offer86.com,http://xiangqi-demo.offer86.com,https://xiangqi-demo.offer86.cn,http://xiangqi-demo.offer86.cn,https://xiangqi-demo.86offer.com,http://xiangqi-demo.86offer.com,https://xiangqi-demo.86offer.cn,http://xiangqi-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
