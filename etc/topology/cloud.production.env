SDKWORK_DEPLOYMENT_PROFILE=cloud
SDKWORK_CORS_ALLOWED_ORIGINS=https://xiangqi.sdkwork.com,https://xiangqi.birdcoder.com,https://xiangqi.dtupay.com,https://xiangqi.noaper.com,https://xiangqi.sdkwork.cn,https://xiangqi.birdcoder.cn,https://xiangqi.dtupay.cn,https://xiangqi.noaper.cn,https://xiangqi.skubc.com,https://xiangqi.skubc.cn,https://xiangqi.zowalk.com,https://xiangqi.zowalk.cn,https://xiangqi.offer86.com,https://xiangqi.offer86.cn,https://xiangqi.86offer.com,https://xiangqi.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
SDKWORK_RUNTIME_TARGET=browser
SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=db.example.com
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_prod
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_prod
SDKWORK_DATABASE_USERNAME=sdkwork_ai_prod
SDKWORK_DATABASE_PASSWORD_FILE=/etc/sdkwork/database/database.secret
SDKWORK_DATABASE_SSL_MODE=require
SDKWORK_DATABASE_MAX_CONNECTIONS=20

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_XIANGQI_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Canonical profile identity (SOURCE_CONFIG_SPEC.md)
SDKWORK_XIANGQI_ENVIRONMENT=production
SDKWORK_XIANGQI_DEPLOYMENT_PROFILE=cloud
SDKWORK_XIANGQI_PROFILE_ID=cloud.production
